NEXT_PUBLIC_SITE_URL=https://epicglobalinc.com
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LEAD_CAPTURE_PROVIDER=hubspot
# Dedicated AWS API Gateway /lead-capture endpoint. Do not point browser code
# directly at Copperline and do not include credentials in this value.
NEXT_PUBLIC_LEAD_GATEWAY_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_COPPERLINE_PUBLIC_URL=https://crm.epicglobalinc.com
NEXT_PUBLIC_COPPERLINE_WORKSPACE=epicglobalinc

# Server-only settings for the local Next.js gateway fallback. Production uses the
# isolated AWS gateway and stores equivalent signing values in Secrets Manager.
# Never prefix secrets with NEXT_PUBLIC_.
COPPERLINE_LEAD_INTAKE_URL=https://crm.epicglobalinc.com/api/v1/lead-intake
COPPERLINE_LEAD_INTAKE_SOURCE_ID=epic-website
COPPERLINE_LEAD_INTAKE_HMAC_SECRET=
COPPERLINE_LEAD_ALLOWED_ORIGINS=https://epicglobalinc.com,https://www.epicglobalinc.com
COPPERLINE_LEAD_ALLOWED_FORMS=contact,book-a-call,marketplace-assessment
COPPERLINE_LEAD_PRIVACY_NOTICE_VERSION=website-privacy-2026-07
COPPERLINE_LEAD_LAWFUL_BASIS=legitimate_interests
COPPERLINE_LEAD_WAF_PROTECTED=false

# Legacy same-origin AWS WAF fallback only; not used by the dedicated gateway path.
NEXT_PUBLIC_AWS_WAF_INTEGRATION_URL=

# CloudFront must overwrite this private origin header after AWS WAF allows the request.
COPPERLINE_LEAD_EDGE_PROOF_HEADER=x-epic-edge-proof
COPPERLINE_LEAD_EDGE_PROOF_SECRET=
COPPERLINE_LEAD_ALLOW_LOCAL_PROOF=false
